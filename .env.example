# .env — Solar Power Plant Analysis System
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Database ---
# Read-only PostgreSQL connection string (psycopg v3 driver).
# The DB user should only have SELECT privileges on the 5 tables.
DATABASE_URL=postgresql+psycopg://solar_ro:changeme@localhost:5432/solardata

# --- LLM ---
# Default provider is groq (options: groq, gemini, anthropic, openai, ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_PLANNER_MODEL=llama-3.3-70b-versatile
LLM_AGENT_MODEL=llama-3.1-8b-instant
LLM_SYNTH_MODEL=llama-3.3-70b-versatile
LLM_MAX_RPM=20

# Optional fallback keys for other providers
GOOGLE_API_KEY=your-google-api-key-here

# --- LangSmith (optional but recommended) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=solar-power-analysis
