# .env — Solar Power Plant Analysis System
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Database ---
# Read-only PostgreSQL connection string (psycopg v3 driver).
# The DB user should only have SELECT privileges on the 5 tables.
DATABASE_URL=postgresql+psycopg://solar_ro:changeme@localhost:5432/solar_db

# --- LLM ---
# Google AI API key for Gemini 2.5 Pro (Orchestrator/Synthesizer)
# and Gemini 2.5 Flash (Data Agent/Validator).
GOOGLE_API_KEY=your-google-api-key-here

# --- LangSmith (optional but recommended) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=solar-power-analysis
